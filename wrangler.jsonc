{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workstation",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "main": ".open-next/worker.js",
  "routes": [
    {
      "pattern": "zenqar.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "FX_PROVIDER": "mock",
    "FX_FALLBACK_RATE": "1310",
    "NEXT_PUBLIC_SUPABASE_URL": "https://rdhflhsmftlncuiyrjdl.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_SoMOF0LHkZc6ZZFn6RlULA_wEXU-ank",
    "NEXT_PUBLIC_APP_URL": "https://zenqar.com",
    "OPENROUTER_MODEL": "nvidia/nemotron-nano-12b-v2-vl:free",
    "OPENROUTER_CHAT_MODEL": "tencent/hy3:free"
  },
  "secrets": {
    "required": [
      "SUPABASE_SERVICE_ROLE_KEY",
      "OPENROUTER_API_KEY"
    ]
  },
  "observability": {
    "enabled": true
  }
}
